APP_NAME="OdonTech Colombia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de Datos (PostgreSQL) ───────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=odontech
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Integración DIAN y PTA (Sector Salud) ────────────────────────────────
DIAN_PTA_PROVEEDOR=factus
DIAN_AMBIENTE=sandbox
DIAN_FACTUS_URL_SAND=https://api-sandbox.factus.com.co
DIAN_FACTUS_URL_PROD=https://api.factus.com.co
DIAN_FACTUS_CLIENT_ID=
DIAN_FACTUS_CLIENT_SECRET=
DIAN_FACTUS_USERNAME=
DIAN_FACTUS_PASSWORD=
DIAN_FACTUS_TOKEN=

ODONTECH_PRESTADOR_NIT=901234567
ODONTECH_PRESTADOR_DV=1
ODONTECH_PRESTADOR_RAZON_SOCIAL="CENTRO ODONTOLOGICO ODONTECH SAS"
ODONTECH_PRESTADOR_CODIGO_REPS=110010000001
ODONTECH_PRESTADOR_MUNICIPIO=11001
ODONTECH_PRESTADOR_DIRECCION="Calle 100 # 15-20 Consultorio 401"
ODONTECH_PRESTADOR_TELEFONO=6013000000
ODONTECH_PRESTADOR_CORREO=facturacion@odontech.com.co
